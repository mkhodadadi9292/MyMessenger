APP_NAME=Messenger
DEBUG=false
DATABASE_URL=postgresql+asyncpg://messenger:messenger-dev-password@localhost:5432/messenger
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=10
MEDIA_ROOT=./data/media
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30
OTP_TTL_SECONDS=300
OTP_LENGTH=6
MAX_ARTIFACT_SIZE_MB=20

POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres-dev-admin
POSTGRES_HOST_PORT=5432
POSTGRES_MAX_CONNECTIONS=100
MESSENGER_DB_NAME=messenger
MESSENGER_DB_USER=messenger
MESSENGER_DB_PASSWORD=messenger-dev-password
